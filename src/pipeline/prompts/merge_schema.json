{
  "name": "movie_certification_extraction",
  "description": "metadata, cast and intertitles from historical film certificates",
  "strict": true,
  "schema": {
    "type": "object",
    "properties": {
      "examination_number": { "type": ["string", "null"] },
      "stamp_text": { "type": ["string", "null"] },
      "origin_company": { "type": ["string", "null"] },
      "movie_title": { "type": ["string", "null"] },
      "movie_subtitle": { "type": ["string", "null"] },
      "produced_by": { "type": ["string", "null"] },
      "director": { "type": ["string", "null"] },
      "cinematography": { "type": ["string", "null"] },
      "set_design": { "type": ["string", "null"] },
      "cast_list": {
        "type": "array",
        "description": "characters and respective actors",
        "items": {
          "type": "object",
          "properties": {
            "role": { "type": ["string", "null"] },
            "actor": { "type": ["string", "null"] },
            "actor_affiliation": {
              "type": ["string", "null"],
              "description": "theater or company affiliation of the actor, usually in parentheses" 
            }
          }
        },
        "required": ["role", "actor"],
        "additionalProperties": false
      },
      "intertitles": {
        "type": "array",
        "description": "numbered text cards per act",
        "items": {
          "type": "object",
          "properties": {
            "act_label": { "type": ["string", "null"] },
            "text": { "type": ["string", "null"] }
          },
          "required": ["act_label", "text"],
          "additionalProperties": false
        }
      },
      "excerpt_note": { "type": ["string", "null"] },
      "length_details": {
        "type": "object",
        "description": "film length in meters including censorship cuts",
        "properties": {
          "individual_acts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "act_number": { "type": ["string", "null"] },
                "original_length": { "type": ["string", "null"] },
                "length_after_cut": { "type": ["string", "null"] }
              },
              "required": ["act_number", "original_length"],
              "additionalProperties": false
            }
          },
          "total_length": {
            "type": "object",
            "properties": {
              "original_length": { "type": ["string", "null"] },
              "length_after_cut": { "type": ["string", "null"] }
            },
            "required": ["original_length"],
            "additionalProperties": false
          }
        },
        "required": ["individual_acts", "total_length"],
        "additionalProperties": false
      },
      "examination_certificate": {
        "type": "object",
        "description": "administrative details of film examination",
        "properties": {
          "examination_board": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] },
          "date": { "type": ["string", "null"] },
          "decision_text": { "type": ["string", "null"] }
        },
        "required": ["examination_board", "location", "date", "decision_text"],
        "additionalProperties": false
      }
    },
    "required": [
      "examination_number",
      "stamp_text",
      "origin_company",
      "movie_title",
      "movie_subtitle",
      "produced_by",
      "director",
      "cinematography",
      "set_design",
      "cast_list",
      "intertitles",
      "excerpt_note",
      "length_details",
      "examination_certificate"
    ],
    "additionalProperties": false
  }
}